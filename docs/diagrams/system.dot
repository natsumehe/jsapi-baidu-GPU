digraph G {
 graph [rankdir=TB, bgcolor="transparent", splines=ortho, nodesep=.28, ranksep=.52, pad=.3, fontname="Noto Sans CJK SC"];
 node [shape=box, style="rounded,filled", color="#bed4e8", fillcolor="#edf5fb", fontname="Noto Sans CJK SC", fontcolor="#183856", fontsize=12, margin="0.21,0.12"];
 edge [color="#608da9", arrowsize=.7, penwidth=1.3];
 Scene [label="场景应用层\n港口可视化 / AGV 任务 / 对象信息"]; Lab [label="实验应用层\nA / B / E / C / D 对照与 HTTP Stream"];
 Scene -> Engine; Lab -> Dataset; Lab -> GPU; Lab -> Render;
